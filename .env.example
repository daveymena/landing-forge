# ---------- IA (elige UNO; el primero que exista se usa) ----------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# Compatible OpenAI genérico (OpenRouter, Together, LM Studio, Ollama...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Si no hay ninguna key, la app usa el GENERADOR DETERMINISTA (funciona igual, sin IA).

# ---------- Dropi ----------
# Entorno: test | prod
DROPI_ENV=test
# Token de integración (app.dropi.co -> Integraciones -> +Agregar -> copiar token)
# DROPI_TOKEN=
# Esquema de auth: bearer | integration-key
DROPI_AUTH_SCHEME=bearer
# País de la cuenta (co, mx, ec, pe, cl, pa, cr, gt, py, ar, ve, es)
DROPI_COUNTRY=co

# ---------- App ----------
# URL pública de esta app, se inyecta en el HTML exportado para que el form COD sepa a dónde postear
PUBLIC_APP_URL=http://localhost:3000
# Token compartido para que el bot llame a la API (header x-api-key). Vacío = sin auth.
# LANDING_API_KEY=cambia-esto-en-produccion
# Solo para scripts/verificar-landingforge.mjs; definir en la terminal, nunca en el código.
# LANDINGFORGE_API_KEY=
